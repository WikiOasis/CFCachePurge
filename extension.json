{
  "name": "CFCachePurge",
  "author": ["Waki285"],
  "url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:CFCachePurge",
  "descriptionmsg": "cfcachepurge-desc",
  "license-name": "GPL-2.0-or-later",
  "type": "other",
  "requires": {
    "MediaWiki": ">= 1.43.0"
  },
  "AutoloadNamespaces": {
    "MediaWiki\\Extension\\CFCachePurge\\": "src/"
  },
  "config": {
    "CFCachePurgeZoneID": {
      "description": "Cloudflare Zone ID",
      "value": ""
    },
    "CFCachePurgeAPIToken": {
      "description": "Cloudflare API Token",
      "value": ""
    },
    "CFCachePurgeIgnoreImgAuth": {
      "description": "Ignore img_auth.php purge requests",
      "value": false
    },
    "CFCachePurgePurgeableImageHosts": {
      "description": "Purgeable image hosts",
      "value": []
    }
  },
  "HookHandlers": {
    "Main": {
      "class": "MediaWiki\\Extension\\CFCachePurge\\Hooks"
    }
  },
  "Hooks": {
    "FileUpload": {
      "handler": "Main"
    },
    "FileDeleteComplete": {
      "handler": "Main"
    }
  },
  "MessagesDirs": {
    "CFCachePurge": ["i18n"]
  },
  "SpecialPages": {
    "CFCachePurge": "MediaWiki\\Extension\\CFCachePurge\\SpecialCFCachePurge"
  },
  "ExtensionMessagesFiles": {
    "CFCachePurgeAlias": "CFCachePurge.i18n.alias.php"
  },
  "RateLimits": {
		"cfcachepurge": {
			"user": [
				1,
				60
			]
		}
	},
  "AvailableRights": ["cfcachepurge"],
  "manifest_version": 2
}
